# ============================================
# Foodshop Node Docker 环境变量配置
# ============================================
# 注意：此文件包含敏感信息（密码、密钥），已被 .gitignore 忽略
# 不会提交到代码仓库

# Docker 用户名
DOCKER_USER=zoroers

# Ollama 配置
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:0.6b

# Node.js 应用配置
NODE_ENV=production
PORT=3000

# MongoDB 配置
MONGO_PORT=28017

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ 配置
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Nginx 配置
NGINX_PORT=80

# 七牛云配置
QINIU_BUCKET=elm-dev

# ============================================
# 敏感信息配置
# ============================================
# MongoDB 认证
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=your_secure_password_here

# Redis 密码（可选）
# REDIS_PASSWORD=your_redis_password

# RabbitMQ 认证
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here

# MongoDB 连接 URL（包含认证信息）
MONGO_URL=mongodb://root:your_secure_password_here@mongodb:28017/elm_db?authSource=admin

# 七牛云密钥
QINIU_ACCESS_KEY=your_qiniu_access_key
QINIU_SECRET_KEY=your_qiniu_secret_key
